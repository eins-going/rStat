 일제시 행정구역 통폐합시 덕석골의 덕자와 삼상평의 삼자를 따서 덕삼리라 불렀다고 한다."],["도산리","정미면",216,72,97,43,5,0,[10,4,3,10,11,24,7,32,9,5,8,10,9,22,12,40],[0,25,57,15,0],"부락에 옥녀봉, 국사봉, 초당산이란 명산들이 있는데 이 가운데 마을 중심부를 동서로 관통하는 큰 도로가 생길 것이라 하여 도산리라 부르게 되었다한다."],["매방리","정미면",242,94,112,44,0,0,[9,5,7,12,7,18,18,37,11,7,8,8,8,19,11,57],[16,35,50,11,0],"본 마을은 '매화낙반형'이라 하여 옛날부터 거부가 살고 있었으나 나머지 주민은 빈곤을 탈피하지 못하고 심지어 부잣집의 부러운 꿈을 꾸기까지 하였다 하여 '몽매동'이라 불렀다. 매방리는 1914년 일제의 행정구역 통폐합시 몽매동의 매자와 발이방동의 방자를 따서 매방리라 부르게 되었다."],["모평리","정미면",170,55,70,19,0,0,[6,3,7,10,13,15,6,22,8,4,3,7,6,18,9,33],[6,16,35,8,5],"뒤로는 대모산을 최고봉으로 하고 문필봉을 동반하여 남북으로 가로질러 뻗어 내려가던 산이 북에서 봉생리 국사봉을 가리게끔 동쪽으로 굽었으며, 앞에는 대모산에서 흐르는 골짜기 물이 합류하는 역천과 넓은 평야가 있다. 대모산의 모자와 앞에 펼쳐진 평촌이 기름지다 하여 이곳의 평자을 따서 '모평리'라 하였다."],["봉생리","정미면",218,72,106,45,0,0,[8,7,11,18,13,17,13,31,5,3,9,10,6,17,9,41],[16,43,35,9,3],"모씨 가에서 장사를 치르는데 하관 직전에 지사와 상주간의 모종의 알력으로 지사가 조금 더 파야 된다고 하여 다시 파기 시작하였고 밑바닥 돌장을 떠 일으카자 봉황새 한 쌍이 날았다. 이 때 급히 다시 덮는 과정에서 봉황의 발 하나가 부러졌고 하나는 날아서 은봉산에 숨게 되었다는 전설이 전해 내려오고 있다. 이름은 봉이 낳다 하여 봉생리라 하였다고 한다."],["봉성리","정미면",168,73,80,27,0,0,[2,3,10,2,13,19,5,30,6,1,5,2,10,13,4,43],[5,12,50,12,1],"은봉산의 봉황새의 보호를 상징하는 봉화산맥이 마을 동쪽을 가로 막아 둘러 내려 쌓인 곳이라 하여 '봉성리'라 불린다."],["사관리","정미면",143,63,68,30,0,0,[3,3,7,5,8,6,7,24,4,5,5,5,9,5,8,39],[3,12,45,8,0],"사내동의 사자와 진관동의 관자를 따서 사관리라 하였다 한다."],["산성리","정미면",166,77,86,37,0,0,[5,3,5,3,9,9,6,41,6,4,3,4,10,10,12,36],[3,12,45,23,3],"산성리라 부르기 시작한 연대는 미상이나 자모산 아래 동남방에 위치하고 있는 자모산 상부에 옛 성터가 있어 '산성'이라 부르게 되었다 한다."],["수당리","정미면",257,101,120,43,0,0,[8,4,9,18,10,24,8,46,5,3,11,5,10,28,13,55],[12,25,75,8,0],"높고 맑은 산에 참나무가 많아 숯을 굽던 마을이었다. 이름은 숯의 음을 수자로 정하고 원당골의 당자를 따서 '수당리'가 되었다 한다."],["승산리","정미면",193,72,101,53,0,0,[8,2,12,9,16,16,6,31,5,1,2,5,11,21,7,41],[14,17,52,18,0],"노승배불형이라 하여 옛날 노승이 정기적으로 순방하여 성미를 받아 마을의 모든 재난을 방비하는데 시주하여 마을 주민들로부터 찬사를 받고 무고하였다한다. 노승이 죽자 마을 주민은 은공을 기리는 뜻에서 장례를 후히 치러 주었다. 노스이 되로 모은 성미가 산에 비할 만큼 많은 혜택을 받았다하여 승산리로 칭하게 되었다고 한다."],["신시리","정미면",161,54,73,28,0,0,[5,5,11,7,7,16,7,25,8,1,9,6,7,13,5,29],[3,12,35,13,10],"이시산의 시자를 따서 신시리라 부르는 것으로 알려졌을뿐 자세한 유래를 알 수 었다."],["우산리","정미면",105,42,46,11,0,0,[1,3,3,3,3,15,1,22,5,1,4,1,8,12,3,20],[2,12,32,0,0],"마을 뒤편에 남북으로 지른 자모산맥의 우무산이 서북방에 존립하여 마을을 감싸고 있어 마을의 구심점을 이루었다 하여 구한말 서산군이 이 동리에 우자의 음을 우로 하여 우산리라 칭하였다고 한다."],["천의1리","정미면",440,122,221,90,2,120,[16,11,29,20,35,43,14,46,19,8,17,18,28,38,22,76],[10,21,170,0,20],"원래 해미군 염솔면 지역인데 1914년 행정구역 통폐합시 상도곡리, 삼곡리를 합하여 이곳의 천의포에서 이름을 따다가 천의리라 하였다."],["천의2리","정미면",258,65,118,43,0,0,[10,6,17,11,19,30,17,26,10,5,12,12,9,27,8,39],[15,6,72,20,5],"원래 해미군 염솔면 지역인데 1914년 행정구역 통폐합시 상도곡리, 삼곡리를 합하여 이곳의 천의포에서 이름을 따다가 천의리라 하였다."],["하성리","정미면",101,41,47,20,0,0,[9,2,1,3,9,8,5,16,3,1,3,0,5,8,3,25],[5,8,31,3,0],"하성리라 부르기 시작한 것을 알 수 없으나 은봉산의 봉황을 보호하고 있는 자모산의 산맥아래 펼쳐진 마을이라 하여 '산성리', '하성리'라 각각 부르게 되었으며, 은봉산과 연결된 봉화산 기슭의 동네를 '봉성리'라 불렀다."],["교동1리","합덕읍",1077,205,0,0,0,0,[68,31,85,61,83,111,29,85,55,30,45,48,89,105,32,120],[0,0,0,0,0],""],["교동2리","합덕읍",1116,209,0,0,0,0,[71,34,88,62,86,114,31,88,58,33,49,48,91,109,33,121],[0,0,0,0,0],""],["구양도리","합덕읍",107,38,0,0,0,0,[4,3,18,2,6,6,4,15,3,3,1,3,3,10,3,23],[0,0,0,0,0],""],["궁리","합덕읍",123,51,0,0,0,0,[3,2,5,3,8,10,7,23,0,1,5,3,5,14,6,28],[0,0,0,0,0],""],["내동리","합덕읍",109,49,0,0,0,0,[3,1,3,7,6,5,6,25,4,2,2,4,4,6,7,24],[0,0,0,0,0],""],["대호리","합덕읍",128,31,0,0,0,0,[9,5,7,8,13,13,2,12,6,5,5,2,10,7,5,19],[0,0,0,0,0],""],["덕곡리","합덕읍",230,85,0,0,0,0,[6,2,10,12,14,26,10,38,7,4,8,4,8,25,9,47],[0,0,0,0,0],""],["도곡리","합덕읍",205,59,0,0,0,0,[13,7,10,8,15,29,7,28,5,2,13,8,7,15,7,31],[0,0,0,0,0],""],["도리","합덕읍",194,61,0,0,0,0,[11,5,14,8,15,18,7,26,4,4,8,5,11,15,8,35],[0,0,0,0,0],""],["묵성리","합덕읍",152,40,58,11,3,5,[7,3,13,6,8,20,3,20,1,1,11,3,12,13,11,20],[5,5,15,10,20],""],["삼호리","합덕읍",71,37,0,0,0,0,[2,0,4,2,4,4,1,15,2,0,2,2,4,4,3,22],[0,0,0,0,0],""],["상개리","합덕읍",126,44,0,0,0,0,[6,2,8,4,9,11,4,19,6,4,2,3,8,10,5,25],[0,0,0,0,0],""],["상궁원리","합덕읍",111,46,0,0,0,0,[4,0,3,8,3,7,9,23,0,0,7,2,3,10,9,23],[0,0,0,0,0],""],["상동리","합덕읍",86,38,0,0,0,0,[4,2,5,4,3,11,3,19,1,1,1,1,4,7,1,19],[0,0,0,0,0],""],["상흑리","합덕읍",102,39,