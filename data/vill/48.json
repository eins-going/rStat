,8,2,12,22,12,37,8,4,6,4,12,19,6,49],[0,0,0,0,0],"○ 지방도 647호선을 중심으로 양 옆으로 길게 뻗은 마을이라고 해서 길 장(長)를 쓰고, 오래 전부터 항상 마르지 않는 우물(‘고래샘’)이 있어 우물 정(井)자를 더해 장정리라고 함 ○ 전설에 따르면 신라 경덕왕 때부터 큰 우물이 있다하여 정곡(井谷)이라 불림. 그 우물은 항상 마르지 않는 용출수로 어느 때부터인가 주민들은 고래가 물을 뿜듯이 물이 잘난다고 해 고래샘이라 부름 ○ 또 다른 전설에 따르면 마을 입구에 있는 장승과 관련됨. 1886년 마을에 심한 가뭄이 들고 전염병이 발생해 동네 사람들이 많이 죽고 초가집 수십 채가 원인 모를 화재로 불타자 마을 사람들이 장승을 세워 장승제를 지내게 됨. 지금도 매년 음력 정월 14일 장승제를 지내고 있음"],["적서리","대호지면",385,136,176,73,0,0,[14,6,22,15,24,39,19,59,9,8,12,8,17,34,22,77],[0,0,0,0,0],"● 원래는 해미군 서면지역으로 이 일대의 토색이 유난히도 붉기 때문에 붉은 땅이라 해서 적서리라 했다는 설이 있으며, 늙은 쥐가 밭에 내리는 형국이기 때문이라는 설, 도산이라는 도사가 산세를 보고 적서리라 했다는 설 등 지명의 유래는 다양함 ● 대부분의 지대가 평지로 이루어져 있는 전형적인 농촌 마을이며 북쪽에 수구지들이 펼쳐져있으며 동쪽에는 한다리골과 지미재골이 자리하고 있음 ● 자연마을로는 적서, 돌개, 선녀굴마을 등이 있음"],["조금리","대호지면",515,126,227,63,9,30,[23,12,28,33,22,48,31,61,23,10,32,17,25,57,28,65],[16,41,91,48,40],"옛 해미군 서면 조금진리 지역으로 조금초등학교 뒤에 잇는 청룡산이 옥녀탄금형이고 앞산이 거문고를 고르는 형이며 서편에는 바다가 있어 서산시 지곡면과 대산읍 및 인천과 왕래하는 나루터가 있었기에 조금진이라 했다."],["출포리","대호지면",176,78,96,44,4,12,[1,1,6,7,12,20,9,27,0,5,6,2,5,15,9,51],[8,17,38,20,17],"산줄기가 바닷가로 날개처럼 길게 뻗었으므로 날개 또는 출포리라 한다. 또한 뱃터를 중심으로 갯벌에서 부락이 이루어져서 출포리가 되었다는 유래도 있다."],["대치리","면천면",195,64,99,42,3,15,[0,3,5,10,12,19,18,21,1,7,2,6,6,24,18,43],[0,0,0,0,0],""],["문봉1리","면천면",196,39,86,31,5,20,[4,3,9,14,21,17,21,12,6,3,9,7,10,15,18,27],[0,0,0,0,0],""],["문봉2리","면천면",299,57,131,53,4,14,[10,13,19,22,22,36,17,25,16,7,11,7,17,25,20,32],[0,0,0,0,0],""],["사기소리","면천면",159,47,66,23,2,20,[2,4,8,4,9,18,12,26,1,4,11,1,7,17,14,21],[0,0,0,0,0],""],["삼웅1리","면천면",127,35,53,20,2,10,[4,6,6,2,10,15,5,19,0,5,8,5,7,9,10,16],[0,0,0,0,0],""],["삼웅2리","면천면",130,43,67,25,1,10,[2,4,7,4,10,11,13,16,1,1,2,3,5,10,14,27],[0,0,0,0,0],""],["성상1리","면천면",796,70,382,0,5,20,[26,46,49,47,72,78,60,25,34,39,42,39,66,69,59,45],[0,0,0,0,0],""],["성상2리","면천면",305,59,137,48,7,30,[3,24,23,18,24,24,21,25,4,9,6,11,25,24,30,34],[0,0,0,0,0],""],["성하리","면천면",274,68,130,48,2,15,[7,10,12,23,14,26,23,31,1,6,10,8,10,27,29,37],[0,0,0,0,0],""],["송학1리","면천면",128