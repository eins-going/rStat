{
  "cleanUrls": false,
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/producers",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/facilities",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gohyang",
      "destination": "/jikbul",
      "permanent": false
    },
    {
      "source": "/gohyang.html",
      "destination": "/jikbul",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/((?!google)[A-Za-z0-9_-]+)\\.html",
      "destination": "/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/)[A-Za-z0-9_-]+)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(data|research|scripts|docs|src|api)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(package.json|package-lock.json|vercel.json)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
