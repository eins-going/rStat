{
  "cleanUrls": true,
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/producers",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/facilities",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gohyang",
      "destination": "/jikbul",
      "permanent": false
    },
    {
      "source": "/gohyang.html",
      "destination": "/jikbul",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(data|research|scripts|docs|src|api)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(package.json|package-lock.json|vercel.json)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
